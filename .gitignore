# Dependencies
node_modules/

# Build output
dist/
out/
build-temp/

# Runtime-fetched binaries — root vendor/ only.
# NOTE: renderer/vendor/ (hls, wavesurfer, pdfjs, fabric, lucide) IS committed.
/vendor/

# Build-time-only tooling fetched by build-linux.sh (appimagetool), never shipped.
/build/.tools/

# Docker deployment secrets (FLUX_ADMIN_PASSWORD) — never commit, copy from .env.example.
/.env

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDE / local tooling
.vscode/
.idea/
*.swp
*~
